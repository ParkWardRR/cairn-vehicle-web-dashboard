# Caddyfile — browser-facing HTTPS for the Cairn web UI.
#
# Caddy reverse-proxies to the Nuxt 3 SSR server on :3000. It deliberately
# does NOT proxy the device ingest API.
#
# Why: the ingest handler authenticates a device by reading the TLS client
# certificate off the connection — r.TLS.PeerCertificates[0].Subject.CommonName,
# compared against the device id inside the signed manifest, so a stolen card
# cannot upload as a different device. Terminating TLS in Caddy makes r.TLS nil
# at the handler, and the only way to recover the identity is for Caddy to
# forward it in a header that the server then has to trust. Anything able to
# reach the backend could set that header. A reverse proxy cannot sit in front
# of mutual TLS without dissolving the mutual half.
#
# So cairn-server terminates its own TLS on :8443 against a private CA, via
# deploy/systemd/cairn-server.service. There is a second reason to keep that
# path free of ACME: the device has to be able to deliver a trip when the
# internet is down, and a certificate that needs renewing from Let's Encrypt is
# a dependency on the internet being up.
#
# TLS here follows the house pattern — Let's Encrypt over the Cloudflare DNS-01
# challenge, so an internal hostname gets a publicly trusted certificate without
# being publicly reachable. Requires CF_API_TOKEN in /etc/caddy/env and a Caddy
# built with the cloudflare DNS module:
#
#   caddy add-package github.com/caddy-dns/cloudflare

cairn.alpina.casa {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}

	# A device that mistakenly points at :443 should get a clear refusal rather
	# than an HTML page it will try to parse as CBOR.
	handle /api/v2/* {
		respond "device ingest is on :8443 with mutual TLS, not through this proxy" 421
	}

	reverse_proxy localhost:3000
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Nuxt emits content-hashed assets under /_nuxt/.
	@immutable path /_nuxt/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	log {
		output stdout
		format console
	}
}
