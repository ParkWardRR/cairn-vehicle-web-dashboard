# Caddyfile.podman — rootless Podman variant
#
# Listens on :80 inside the container, port-forwarded to 8080 on the host.
#
# The API is NOT proxied here, and that is a correctness requirement rather than
# a simplification: device ingest authenticates by reading the TLS client
# certificate off the connection, so a proxy that terminates TLS reduces the
# check to trusting a forwarded header. See the note in ./Caddyfile. The device
# talks to cairn-server on :8443 directly.

:80 {
	handle /api/* {
		respond "device ingest is on :8443 with mutual TLS, not through this proxy" 421
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		encode gzip zstd

		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
		}

		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@notimmutable not path /_app/immutable/*
		header @notimmutable Cache-Control "no-cache"
	}

	log {
		output stdout
		format console
	}
}
