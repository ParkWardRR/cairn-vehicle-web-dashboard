# Caddyfile.podman — rootless Podman variant
#
# Listens on :80 inside the container, port-forwarded to 8080 on the host.
# API proxied to ingestd on the host via host.containers.internal.

:80 {
	handle /api/v1/* {
		reverse_proxy host.containers.internal:8443
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		encode gzip zstd

		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
		}

		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@notimmutable not path /_app/immutable/*
		header @notimmutable Cache-Control "no-cache"
	}

	log {
		output stdout
		format console
	}
}
