# /etc/cairn/ui.env (mode 0640, owner root:cairn). Copy this file and fill it in.

# Geoapify (https://www.geoapify.com): reverse geocoding and nearby places.
# The free plan needs the "Powered by Geoapify" credit, which the UI shows.
# Leave empty to run on OpenStreetMap (and Foursquare, if loaded) alone.
NUXT_GEOAPIFY_KEY=

# Set to false to stop all lookups that send coordinates off the machine. Names
# already cached, and any Foursquare extract, keep working.
# NUXT_PLACES_EXTERNAL=true
