# /etc/cairn/ui.env (mode 0640, owner root:cairn). Copy this file and fill it in.

# Geoapify (https://www.geoapify.com): reverse geocoding and nearby places.
# The free plan needs the "Powered by Geoapify" credit, which the UI shows.
# Leave empty to run on OpenStreetMap (and Foursquare, if loaded) alone.
NUXT_GEOAPIFY_KEY=

# Set to false to stop all lookups that send coordinates off the machine. Names
# already cached, and any Foursquare extract, keep working.
# NUXT_PLACES_EXTERNAL=true

# ── Authentication (see docs/auth.md) ────────────────────────────────────────

# Where passkeys may be used: the address(es) people type, with the scheme. Required.
NUXT_AUTH_ORIGINS=https://cairn.example.lan

# Tailnet logins (comma-separated) that are signed in by their device's address, so the app on a
# phone or laptop on your tailnet needs no sign-in. Leave empty to use passkeys only.
NUXT_AUTH_TAILNET_USERS=

# Days a passkey session lasts (default 30).
# NUXT_AUTH_SESSION_DAYS=30

# ── Add a phone (docs/auth.md) ───────────────────────────────────────────────

# The https URL the phone reaches cairn-server's app listener at (not this site), the private CA the
# phone should trust, and the file holding cairn-server's local write token (-app-local-token-file).
# NUXT_PHONE_SETUP_URL=https://cairn.example.lan:8444
# NUXT_PHONE_SETUP_CA_FILE=/etc/cairn/certs/ca.pem
# NUXT_CAIRN_LOCAL_TOKEN_FILE=/etc/cairn/local-write-token
# Optional second route for a phone away from home:
# NUXT_PHONE_SETUP_TAILNET_URL=https://cairn-host.example-tailnet.ts.net
