[Unit]
Description=Cairn web UI (Nuxt 3 SSR)
After=network.target cairn-tsdb.service

[Service]
Type=simple
User=cairn
WorkingDirectory=/srv/cairn-ui
ExecStart=/usr/bin/node .output/server/index.mjs
Environment=NITRO_PORT=3000
Environment=NUXT_TSDB_URL=http://127.0.0.1:8480
Environment=NUXT_PUBLIC_MAP_PROVIDER=apple
Environment=NUXT_APPLE_MAP_TEAM_ID=
Environment=NUXT_APPLE_MAP_KEY_ID=
Environment=NUXT_APPLE_MAP_PRIVATE_KEY_PATH=/etc/cairn/apple-maps.p8

ProtectSystem=strict
ReadWritePaths=/srv/cairn-ui
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
